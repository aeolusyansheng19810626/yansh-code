import tools


def _dispatch_tool_call(tool_name: str, tool_args: dict):
    """Dispatch a tool call to the appropriate handler.

    Read-only tools are registered in readonly_handlers and routed here
    by tool_name.
    """
    readonly_handlers = {
        "count_lines": tools.count_lines,
    }

    if tool_name in readonly_handlers:
        return readonly_handlers[tool_name](**tool_args)

